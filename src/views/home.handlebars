<section class="hero">
  <div class="container">
    <h1>Cup Store</h1>
    <p>Vasos y tazas para acompañar cada momento del día.</p>
  </div>
</section>

<section class="palette-section">
  <div class="container">
    <h2 class="section-title">Nuestros productos</h2>
    <div class="products-grid" id="productsList">
      {{#each products}}
        <div class="product-card" data-id="{{this.id}}">
          <div class="product-img">
            {{#if this.img}}
              <img src="{{this.img}}" alt="{{this.name}}" class="product-image">
            {{else}}
              <i class="fas fa-mug-hot"></i>
            {{/if}}
          </div>
          <div class="product-info">
            {{#if this.category}}
              <div class="product-category">{{this.category}}</div>
            {{/if}}
            <h3 class="product-title">{{this.name}}</h3>
            {{#if this.description}}
              <p>{{this.description}}</p>
            {{/if}}
            <div class="product-price">${{this.price}}</div>
            <div class="product-actions">
              <button class="cta-button add-to-cart-btn" data-id="{{this.id}}">Agregar al carrito</button>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  </div>
</section>

<script src="/js/index.js"></script>
