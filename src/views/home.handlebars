<div>
  <h1>Home Page</h1>

  <form id="formNewProduct">
    <input type="text" name="name" placeholder="Nombre" required>
    <input type="number" name="price" placeholder="Precio" step="0.01" required>
    <input type="text" name="category" placeholder="Categoría">
    <label><input type="checkbox" name="available" checked> Disponible</label>
    <button type="submit">Agregar producto</button>
  </form>

  <ul id="productsList">
    {{#each products}}
      <li data-id="{{this.id}}">
        {{this.name}} - ${{this.price}}
        <button class="delete-btn" data-id="{{this.id}}">Eliminar</button>
      </li>
    {{/each}}
  </ul>
</div>
<script src="/js/index.js"></script>
