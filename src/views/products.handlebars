<section class="palette-section">
  <div class="container">
    <h1 class="section-title">Productos</h1>

    <form method="GET" class="product-actions">
      <input class="input" name="query" value="{{query}}" placeholder="Categoría">
      <select class="input" name="sort">
        <option value="">Sin orden</option>
        <option value="asc" {{#if (eq sort "asc")}}selected{{/if}}>Precio ↑</option>
        <option value="desc" {{#if (eq sort "desc")}}selected{{/if}}>Precio ↓</option>
      </select>
      <button class="cta-button" type="submit">Filtrar</button>
    </form>

    <div class="products-grid">
      {{#each products}}
        <div class="product-card">
          <div class="product-img">
            {{#if this.img}}
              <img src="{{this.img}}" alt="{{this.name}}" class="product-image">
            {{else}}
              <i class="fas fa-mug-hot"></i>
            {{/if}}
          </div>
          <div class="product-info">
            {{#if this.category}}
              <div class="product-category">{{this.category}}</div>
            {{/if}}
            <h3 class="product-title">{{this.name}}</h3>
            <div class="product-price">${{this.price}}</div>
            <div class="product-actions">
              <a class="cta-button" href="/products/{{this.id}}">Ver detalles</a>
              <button class="cta-button add-to-cart-btn" data-id="{{this.id}}">Agregar al carrito</button>
            </div>
          </div>
        </div>
      {{/each}}
    </div>

    <div class="product-actions">
      {{#if hasPrevPage}}
        <a class="cta-button" href="/products?limit={{limit}}&page={{prevPage}}&sort={{sort}}&query={{query}}">← Anterior</a>
      {{/if}}

      <span>Página {{currentPage}} de {{totalPages}}</span>

      {{#if hasNextPage}}
        <a class="cta-button" href="/products?limit={{limit}}&page={{nextPage}}&sort={{sort}}&query={{query}}">Siguiente →</a>
      {{/if}}
    </div>
  </div>
</section>
